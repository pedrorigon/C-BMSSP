{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SSSP_BUILD_TESTS": "ON",
        "SSSP_BUILD_VALIDATION": "ON",
        "SSSP_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "sanitizers",
      "inherits": "debug",
      "cacheVariables": {
        "SSSP_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "library-release",
      "inherits": "release",
      "cacheVariables": {
        "SSSP_BUILD_TESTS": "OFF",
        "SSSP_BUILD_VALIDATION": "OFF"
      }
    },
    {
      "name": "tests",
      "inherits": "debug",
      "cacheVariables": {
        "SSSP_ENABLE_TEST_COVERAGE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers"
    },
    {
      "name": "library-release",
      "configurePreset": "library-release"
    },
    {
      "name": "tests",
      "configurePreset": "tests"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers",
      "environment": {
        "OMP_NUM_THREADS": "2"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tests",
      "configurePreset": "tests",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
